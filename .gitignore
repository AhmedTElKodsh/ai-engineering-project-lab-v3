# Local secrets and machine-specific settings
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.pfx
*.p12
*.user.toml
.codex/config.toml
.local/

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Regenerable BMAD snapshots; preserve installed project skills and runtime
_bmad/render/
.bmad-help-setup*.toml

# Host skill directories. Vendored BMAD skills are local junctions to .agents and
# stay untracked; the native tutor is tracked so a fresh clone can register it in
# Claude Code as well as in the .agents convention.
.claude/skills/*
!.claude/skills/ai-engineering-tutor/

# Learner data and transient output must be deliberately selected for publication
data/private/
data/raw/
*.log
node_modules/
dist/
Thumbs.db
.DS_Store
